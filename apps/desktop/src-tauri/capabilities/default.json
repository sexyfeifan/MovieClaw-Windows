{
  "identifier": "default",
  "description": "Default capability for MovieClaw Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "shell:allow-execute",
    "shell:allow-kill",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "allow-save-server-url",
    "allow-load-server-url",
    "allow-clear-server-url",
    "allow-probe-server",
    "allow-check-for-updates",
    "allow-open-download-page",
    "allow-open-release-page",
    "allow-proxy-api",
    "allow-get-server-url",
    "allow-has-embedded-player",
    "allow-launch-embedded-player",
    "allow-resize-embedded-player",
    "allow-set-embedded-player-visible",
    "allow-stop-embedded-player",
    "allow-send-mpv-command-embedded",
    "allow-get-main-window-hwnd",
    "allow-discover-servers"
  ]
}
