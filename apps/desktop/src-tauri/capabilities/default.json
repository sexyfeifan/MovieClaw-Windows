{
  "identifier": "default",
  "description": "Default capability for MovieClaw Desktop",
  "windows": ["main"],
  "remote": {
    "urls": ["http://*:*", "https://*:*"]
  },
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-kill",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    },
    "allow-launch-player",
    "allow-stop-player",
    "allow-save-server-url",
    "allow-load-server-url",
    "allow-clear-server-url",
    "allow-probe-server",
    "allow-send-mpv-command",
    "allow-check-for-updates",
    "allow-open-download-page",
    "allow-open-release-page",
    "allow-show-volume-window",
    "allow-hide-volume-window",
    "allow-toggle-volume-window",
    "allow-proxy-api",
    "allow-get-server-url"
  ]
}
