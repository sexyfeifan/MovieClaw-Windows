{
  "identifier": "default",
  "description": "Default capability for MovieClaw Desktop",
  "windows": ["main", "controls"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-kill",
    "shell:allow-open",
    "allow-launch-player",
    "allow-stop-player",
    "allow-save-server-url",
    "allow-load-server-url",
    "allow-clear-server-url",
    "allow-probe-server",
    "allow-send-mpv-command",
    "allow-open-controls-window",
    "allow-close-controls-window",
    "allow-check-for-updates",
    "allow-open-download-page",
    "allow-open-release-page"
  ]
}
